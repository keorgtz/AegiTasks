# Run scripts/setup-env.sh on Ubuntu to generate .env with random passwords.
# Use hexadecimal passwords for PostgreSQL to avoid connection-string delimiters.
POSTGRES_PASSWORD=replace-with-random-hex-password
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
